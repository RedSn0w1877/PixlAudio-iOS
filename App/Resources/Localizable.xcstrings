    "settings_backup_how_dialog_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose sections, export a .pxpl file, and import it later. Restore only replaces the sections you select."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereiche auswählen, als .pxpl exportieren und später importieren. Nur die gewählten Bereiche werden überschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige secciones, exporta un archivo .pxpl e impórtalo más tarde. La restauración solo reemplaza las secciones que selecciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les sections, exportez un fichier .pxpl et importez-le plus tard. La restauration remplace uniquement les sections que vous sélectionnez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bagian, ekspor file .pxpl, dan impor nanti. Pemulihan hanya menggantikan bagian yang Anda pilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli le sezioni, esporta un file .pxpl e importalo in seguito. Il ripristino sostituisce solo le sezioni che selezioni."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose sections, export a .pxpl file, and import it later. Restore only replaces the sections you select."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg seksjoner, eksporter en .pxpl-fil, og importer den senere. Gjenoppretting erstatter bare de valgte seksjonene."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите разделы, экспортируйте файл .pxpl и при необходимости импортируйте его позже. При восстановлении будут заменены только выбранные разделы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölümleri seçin, bir .pxpl dosyası olarak dışa aktarın ve daha sonra içe aktarın. Geri yükleme işlemi yalnızca seçtiğiniz bölümleri değiştirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择版块，导出一个 .pxpl 文件，并在稍后导入它。恢复操作仅替换您选择的版块。"
          }
        }
      }
    },
