    "settings_devcaps_report_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generate a shareable diagnostic report to help us classify playback or scan lag. It contains only device, library, and timing data — no file paths, titles, or artists."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generiere einen teilbaren Diagnosebericht, um uns bei der Klassifizierung von Wiedergabe- oder Scanverzögerungen zu helfen. Er enthält nur Geräte-, Bibliotheks- und Timing-Daten – keine Dateipfade, Titel oder Künstler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera un informe de diagnóstico para compartir que nos ayude a clasificar los retrasos en la reproducción o el escaneo. Contiene solo datos del dispositivo, de la biblioteca y de tiempos, sin rutas de archivos, títulos ni artistas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez un rapport de diagnostic partageable pour nous aider à classifier les ralentissements de lecture ou d'analyse. Il contient uniquement des données sur l'appareil, la bibliothèque et les temps de réponse — aucun chemin de fichier, titre ou artiste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat laporan diagnostik yang dapat dibagikan untuk membantu kami mengklasifikasikan lag pemutaran atau pemindaian. Laporan ini hanya berisi data perangkat, pustaka, dan waktu — tanpa jalur file, judul, atau artis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera un report diagnostico condivisibile per aiutarci a classificare i rallentamenti di riproduzione o scansione. Contiene solo dati sul dispositivo, sulla libreria e sulle tempistiche — nessun percorso di file, titolo o artista."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 또는 스캔 지연 분류를 돕기 위해 공유 가능한 진단 보고서를 생성합니다. 파일 경로, 제목 또는 아티스트 정보는 포함되지 않고 기기, 라이브러리 및 타이밍 데이터만 포함됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generer en delbar diagnose-rapport for å hjelpe oss å klassifisere avspillings- eller skannelag. Den inneholder kun enhets-, biblioteks- og tidsdata — ingen filbaner, titler eller artister."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте диагностический отчёт для отправки, чтобы помочь нам выявить проблемы с воспроизведением или медленным сканированием. Отчёт содержит только данные об устройстве, медиатеке и времени выполнения — без путей к файлам, названий треков и исполнителей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatma veya tarama gecikmelerini sınıflandırmamıza yardımcı olacak paylaşılabilir bir tanılama raporu oluşturun. Rapor yalnızca cihaz, kitaplık ve zamanlama verilerini içerir; dosya yolları, başlıklar veya sanatçılar yer almaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成一份可分享的诊断报告，以帮助我们分类播放或扫描卡顿问题。该报告仅包含设备、媒体库和计时数据 — 不包含文件路径、标题或艺术家。"
          }
        }
      }
    },
