        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все пользовательские разделители будут удалены и заменены значениями по умолчанию. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem tüm özel sınırlayıcılarınızı temizleyecek ve varsayılanları geri yükleyecektir. Bu işlem geri alınamaz."
