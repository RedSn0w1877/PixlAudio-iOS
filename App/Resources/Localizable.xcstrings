    "settings_dialog_rebuild_database_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will completely rebuild your music library from scratch. All imported lyrics, favorites, and custom metadata will be lost. This action cannot be undone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird deine Musikbibliothek komplett neu aufgebaut. Alle importierten Lyrics, Favoriten und benutzerdefinierten Metadaten gehen verloren. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reconstruirá por completo tu biblioteca musical desde cero. Se perderán todas las letras importadas, favoritos y metadatos personalizados. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela reconstruira complètement votre bibliothèque musicale à partir de zéro. Toutes les paroles importées, les favoris et les métadonnées personnalisées seront perdus. Cette action ne peut pas être annulée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan sepenuhnya membangun kembali pustaka musik Anda dari awal. Semua lirik yang diimpor, favorit, dan metadata kustom akan hilang. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo ricostruirà completamente la tua libreria musicale da zero. Tutti i testi importati, preferiti e metadati personalizzati andranno persi. Questa azione non può essere annullata."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악 라이브러리를 처음부터 완전히 다시 구축합니다. 가져온 모든 가사, 즐겨찾기 및 사용자 지정 메타데이터가 손실됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil gjenoppbygge musikkbiblioteket ditt helt fra bunnen av. Alle importerte sangtekster, favoritter og egendefinerte metadata vil gå tapt. Denne handlingen kan ikke angres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Музыкальная медиатека будет полностью пересоздана с нуля. Все импортированные тексты песен, избранное и пользовательские метаданные будут удалены. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem müzik kitaplığınızı sıfırdan tamamen yeniden oluşturacaktır. İçe aktarılan tüm şarkı sözleri, favoriler ve özel meta veriler kaybolacaktır. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从头开始完全重建您的音乐库。所有导入的歌词、收藏和自定义元数据都将丢失。此操作无法撤销。"
          }
        }
      }
    },
