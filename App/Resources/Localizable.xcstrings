    "Change the range or play more songs to fill this timeline." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the range or play more songs to fill this timeline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere den Zeitraum oder spiele mehr Songs ab, um diese Zeitlinie zu füllen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el rango o reproduce más canciones para llenar esta línea de tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez la période ou écoutez plus de chansons pour remplir cette chronologie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah rentang atau putar lebih banyak lagu untuk mengisi timeline ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia l'intervallo o riproduci più brani per popolare questa cronologia."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기간을 변경하거나 곡을 더 재생하여 타임라인을 채워보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endre tidsrommet eller spill flere sanger for å fylle denne oversikten."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измените период или прослушайте больше песен, чтобы заполнить эту временную шкалу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaman çizelgesini doldurmak için aralığı değiştirin veya daha fazla şarkı çalın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改时间范围或播放更多歌曲以填充此时间轴。"
          }
        }
      }
    },
