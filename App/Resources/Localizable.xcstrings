          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche zuerst nach bestehenden Problemen und öffne dann einen gezielten Bericht für Fehler, Abstürze, Anfragen oder Fragen."
          }
        },
        "es" : {
          "stringUnit" : {
