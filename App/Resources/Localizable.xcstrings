    "settings_exp_drag_release_bypass" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag release mode bypasses thresholds and close behavior. The swap happens only when the sheet drag gesture ends."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag-Release-Modus umgeht Schwellen und Schließverhalten. Der Wechsel erfolgt nur beim Ende der Zieh-Geste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Soltar arrastre omite los umbrales y el comportamiento de cierre. El intercambio ocurre solo cuando termina el gesto de arrastre del panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Relâchement contourne les seuils et le comportement de fermeture. Le basculement se produit uniquement lorsque le geste de glissement prend fin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode lepas seret mengabaikan ambang batas dan perilaku penutupan. Pertukaran terjadi hanya ketika gerakan seret panel berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità rilascio trascinamento bypassa le soglie e il comportamento di chiusura. Lo scambio avviene solo quando il gesto di trascinamento del foglio termina."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그 해제 모드는 임계값과 닫기 동작을 무시합니다. 시트 드래그 제스처가 끝날 때만 교체가 일어납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra-slipp-modus omgår terskler og lukke-atferd. Byttet skjer kun når arkdrage-gesten avsluttes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим отпускания жеста игнорирует пороги и поведение закрытия. Переключение происходит только после завершения жеста перетаскивания панели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürükleyip bırakma modu, eşikleri ve kapatma davranışını baypas eder. Geçiş yalnızca panel sürükleme hareketi sona erdiğinde gerçekleşir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动释放模式会绕过阈值和关闭行为。交换仅在面板拖动手势结束时发生。"
          }
        }
      }
    },
