    "Before posting logs, screenshots, or videos, remove personal or private information." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before posting logs, screenshots, or videos, remove personal or private information."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne persönliche oder private Informationen, bevor du Protokolle, Screenshots oder Videos veröffentlichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de publicar registros, capturas de pantalla o vídeos, elimina la información personal o privada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de publier des journaux, des captures d'écran ou des vidéos, supprimez les informations personnelles ou privées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum mengunggah log, screenshot, atau video, hapus informasi pribadi atau sensitif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di pubblicare log, screenshot o video, rimuovi le informazioni personali o private."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그, 스크린샷 또는 동영상을 게시하기 전에 개인 또는 민감한 정보를 삭제하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern personlig eller privat informasjon før du legger ut logger, skjermbilder eller videoer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед публикацией логов, скриншотов или видео удалите личную и конфиденциальную информацию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük, ekran görüntüsü veya video paylaşmadan önce kişisel veya özel bilgileri kaldırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在发布日志、截图或视频之前，请删除个人或私人信息。"
          }
        }
      }
    },
