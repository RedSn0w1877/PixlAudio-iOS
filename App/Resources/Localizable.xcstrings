    "word_delimiter_reset_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will clear all your custom word delimiters and restore the default keywords. This action cannot be undone."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى مسح جميع محددات الكلمات المخصصة واستعادة الكلمات المفتاحية الافتراضية. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle deine benutzerdefinierten Wort-Trennzeichen gelöscht und die Standardwerte wiederhergestellt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borrará todos tus delimitadores de palabras personalizados y restaurará las palabras clave predeterminadas. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela effacera tous vos délimiteurs de mots personnalisés et restaurera les mots-clés par défaut. Cette action ne peut pas être annulée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus semua pemisah kata kustom Anda dan mengembalikan kata kunci default. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo cancellerà tutti i tuoi delimitatori parola personalizzati e ripristinerà le parole chiave predefinite. Questa azione non può essere annullata."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 사용자 지정 단어 구분 기호를 지우고 기본 키워드로 복원합니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil slette alle egendefinerte orddelimitere og gjenopprette standardnøkkelordene. Denne handlingen kan ikke angres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все пользовательские словесные разделители будут удалены, а значения по умолчанию восстановлены. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem tüm özel kelime sınırlayıcılarınızı temizleyecek ve varsayılan anahtar kelimeleri geri yükleyecektir. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将清除您所有自定义的单词分隔符并恢复默认关键词。此操作无法撤销。"
          }
        }
      }
    },
