        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biblioteca alcanza %1$lld Hz, por encima de la frecuencia de muestreo de salida actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque atteint %1$lld Hz, ce qui est supérieur au taux d'échantillonnage de la sortie actuelle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pustaka mencapai %1$lld Hz, di atas sample rate output saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria raggiunge %1$lld Hz, sopra la frequenza di campionamento di uscita attuale."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리가 현재 출력 샘플 레이트보다 높은 %1$lld Hz에 도달합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteket når %1$lld Hz, over gjeldende utgangssamplingsfrekvens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В медиатеке есть треки с частотой до %1$lld Гц, что выше текущей частоты вывода."
          }
        },
        "tr" : {
