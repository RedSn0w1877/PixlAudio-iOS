    "multi_artist_info_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PixlAudio splits artist tags using character delimiters (/, ;, &) and word delimiters (feat., ft., vs., x). Word delimiters are matched case-insensitively. \"Extract Artists from Title\" detects patterns like (feat. Artist) in song titles. Backslash (\\) can be used to escape character delimiters."
          }
        }
      }
    },
