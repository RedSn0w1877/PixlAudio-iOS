    "settings_import_backup_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a .pxpl backup file to inspect. You'll choose which sections to restore in the next step."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine .pxpl-Backup-Datei aus, um sie zu überprüfen. Im nächsten Schritt wählst du aus, welche Bereiche wiederhergestellt werden sollen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un archivo de copia de seguridad .pxpl para inspeccionarlo. Elegirás qué secciones restaurar en el siguiente paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un fichier de sauvegarde .pxpl à inspecter. Vous choisirez quelles sections restaurer à l'étape suivante."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih file cadangan .pxpl untuk diperiksa. Anda akan memilih bagian mana yang ingin dipulihkan pada langkah berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona un file .pxpl da ispezionare. Sceglierai quali sezioni ripristinare nel passaggio successivo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검사할 .pxpl 백업 파일을 선택하세요. 다음 단계에서 복구할 섹션을 선택하게 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en .pxpl-fil for inspeksjon. Du velger hvilke seksjoner som skal gjenopprettes i neste trinn."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите файл резервной копии .pxpl для проверки. На следующем шаге вы сможете выбрать разделы для восстановления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İncelemek için bir .pxpl yedekleme dosyası seçin. Bir sonraki adımda hangi bölümlerin geri yükleneceğini seçeceksiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个 .pxpl 备份文件进行检查。您将在下一步选择要恢复的版块。"
          }
        }
      }
    },
    "settings_import_backup_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse or pick from recent backups. Selected data will replace current data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datei auswählen – die importierten Daten ersetzen die aktuellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca o elige entre copias de seguridad recientes. Los datos seleccionados reemplazarán los datos actuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
