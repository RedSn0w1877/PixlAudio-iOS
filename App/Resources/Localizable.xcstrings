    "settings_exp_apply_on_close_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use close threshold to switch back to placeholders while collapsing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließ-Schwelle verwenden, um beim Einklappen zu Platzhaltern zurückzukehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar el umbral de cierre para volver a los marcadores de posición al colapsar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le seuil de fermeture pour revenir aux espaces réservés lors de la réduction."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan ambang batas penutupan untuk beralih kembali to placeholder saat menutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la soglia di chiusura per tornare ai placeholder durante la chiusura."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접히는 동안 플레이스홀더로 다시 전환하기 위해 닫기 임계값을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk lukke-terskel for å bytte tilbake til plassholdere ved sammenfolding."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать порог закрытия для возврата к заполнителям во время сворачивания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daraltılırken yer tutuculara geri dönmek için kapatma eşiğini kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用关闭阈值在折叠时切换回占位图。"
          }
        }
      }
    },
