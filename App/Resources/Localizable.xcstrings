    "setup_backup_have_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you already have a PixlAudio backup, restore it now and skip most of the remaining setup on this device."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان لديك نسخة احتياطية من PixlAudio بالفعل، فاستعدها الآن لتخطي معظم خطوات الإعداد المتبقية على هذا الجهاز."
          }
        },
        "de" : {
