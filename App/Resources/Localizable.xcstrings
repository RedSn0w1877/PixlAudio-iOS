    "settings_devcaps_finding_clear_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your indexed tracks match the decoders Android reports on this device."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine indizierten Titel stimmen mit den von Android gemeldeten Decodern auf diesem Gerät überein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus pistas indexadas coinciden con los decodificadores que Android reporta en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos pistes indexées correspondent aux décodeurs signalés par Android sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek yang Anda indeks cocok dengan dekoder yang dilaporkan Android di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue tracce indicizzate corrispondono ai decoder che Android riporta su questo dispositivo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인덱싱된 트랙이 이 기기의 Android 디코더 보고와 일치합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De indekserte sporene dine samsvarer med dekoderne Android rapporterer på denne enheten."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Треки в вашей медиатеке соответствуют декодерам, доступным на этом устройстве Android."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizinlenmiş parçalarınız, Android'in bu cihazda bildirdiği çözücülerle eşleşiyor."
