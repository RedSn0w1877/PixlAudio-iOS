    "settings_smooth_corners_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use complex shaped corners effectively improving aesthetics but may affect performance on low-end devices"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weichere Eckenform – kann auf älteren Geräten die Performance leicht beeinflussen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquinas con forma compleja que mejoran el aspecto; puede afectar al rendimiento en dispositivos modestos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise des formes d'angles complexes pour une meilleure esthétique, mais peut affecter les performances sur les appareils bas de gamme"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan sudut berbentuk kompleks yang secara efektif meningkatkan estetika tetapi mungkin memengaruhi performa pada perangkat berspesifikasi rendah"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa angoli a forma complessa che migliorano l'estetica ma possono influire sulle prestazioni su dispositivi di fascia bassa"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복잡한 모양의 모서리를 사용하여 미적 감각을 효과적으로 개선하지만, 저사양 기기에서는 성능에 영향을 줄 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker kompleks formede hjørner for å forbedre estetikken, men kan påvirke ytelsen på eldre enheter"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует сложные формы углов для более красивого интерфейса, но может снизить производительность на слабых устройствах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estetiği etkili bir şekilde artırmak için karmaşık şekilli köşeler kullanır ancak düşük donanımlı cihazlarda performansı etkileyebilir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用复杂的圆角形状以有效提升美观度，但可能会影响低端设备的性能"
          }
        }
      }
    },
