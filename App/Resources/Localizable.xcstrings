    "settings_headphones_resume_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If playback paused because headphones were removed, resume automatically when they connect again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wurde die Musik durch das Trennen der Kopfhörer pausiert, läuft sie beim Wiederverbinden weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la reproducción se pausó al quitar los auriculares, reanudar al volver a conectarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la lecture a été mise en pause car le casque a été retiré, elle reprendra automatiquement lors de sa reconnexion."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika pemutaran dijeda karena headphone dilepas, lanjutkan secara otomatis saat terhubung kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la riproduzione era in pausa perché le cuffie erano state rimosse, riprendi automaticamente quando si riconnettono."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤드폰이 제거되어 재생이 일시 중지된 경우, 다시 연결될 때 자동으로 재개합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis avspillingen stoppet fordi hodetelefoner ble fjernet, gjenoppta automatisk når de kobles til igjen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если воспроизведение было приостановлено после отключения наушников, автоматически возобновлять его при повторном подключении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulaklık çıkarıldığı için oynatma duraklatıldıysa, tekrar bağlandığında otomatik olarak devam ettirilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果播放因拔出耳机而暂停，则在重新连接时自动恢复。"
          }
        }
      }
    },
