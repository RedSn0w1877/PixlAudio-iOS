    "settings_devcaps_finding_unknown_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A full library rescan can fill missing MIME, bitrate, and sample-rate data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein vollständiger Rescan der Bibliothek kann fehlende MIME-, Bitraten- und Sample-Rate-Daten ergänzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un reescaneo completo de la biblioteca puede completar los datos faltantes de MIME, tasa de bits y frecuencia de muestreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une analyse complète de la bibliothèque peut compléter les données manquantes (MIME, débit et taux d'échantillonnage)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemindaian ulang pustaka lengkap dapat mengisi data MIME, bitrate, dan sample-rate yang hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scansione completa della libreria può compilare dati MIME, bitrate e frequenza di campionamento mancanti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리 전체 재스캔을 통해 누락된 MIME, 비트레이트 및 샘플 레이트 데이터를 채울 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fullstendig biblioteksskanning kan fylle inn manglende MIME-, bitrate- og samplingsfrekvensdata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полное повторное сканирование медиатеки может заполнить отсутствующие данные MIME-типа, битрейта и частоты дискретизации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam bir kitaplık yeniden taraması; eksik MIME, bit hızı (bitrate) ve örnekleme hızı verilerini doldurabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进行完整的媒体库重新扫描可以填补缺失的 MIME、比特率和采样率数据。"
          }
        }
      }
    },
