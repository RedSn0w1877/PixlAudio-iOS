    "word_delimiter_current_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These keywords split artist names when surrounded by spaces. Matched case-insensitively. Tap to remove."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Schlüsselwörter trennen Künstlernamen, wenn sie von Leerzeichen umgeben sind. Groß-/Kleinschreibung ignoriert. Tippe zum Entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas palabras clave dividen los nombres de los artistas cuando están rodeadas de espacios. Coinciden sin distinguir mayúsculas de minúsculas. Toca para quitar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces mots-clés séparent les noms d'artistes lorsqu'ils sont entourés d'espaces. Correspondance insensible à la casse. Appuyez pour supprimer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata kunci ini memisahkan nama artis jika dikelilingi spasi. Tidak peka huruf besar-kecil. Ketuk untuk menghapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste parole chiave dividono i nomi artista quando circondate da spazi. Corrispondenza senza distinzione maiuscole/minuscole. Tocca per rimuovere."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공백으로 둘러싸여 있을 때 아티스트 이름을 분할하는 키워드입니다. 대소문자를 구분하지 않고 일치합니다. 탭하여 제거하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse nøkkelordene deler artistnavn når de er omgitt av mellomrom. Sammenlignes uten hensyn til store/små bokstaver. Trykk for å fjerne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти ключевые слова разделяют исполнителей при наличии пробелов вокруг них. Без учёта регистра. Нажмите для удаления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu anahtar kelimeler, boşluklarla çevrelendiğinde sanatçı adlarını böler. Büyük/küçük harf duyarsız olarak eşleştirilir. Kaldırmak için dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当这些关键词前后有空格时，会分割艺术家名称。匹配不区分大小写。点击以移除。"
          }
        }
      }
    },
