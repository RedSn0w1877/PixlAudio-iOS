    "delimiter_reset_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will clear all your custom delimiters and restore the defaults. This action cannot be undone."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى مسح جميع المحددات المخصصة واستعادة المحددات الافتراضية. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle deine benutzerdefinierten Trennzeichen gelöscht und die Standards wiederhergestellt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán todos tus delimitadores personalizados y se restaurarán los predeterminados. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela effacera tous vos délimiteurs personnalisés et restaurera ceux par défaut. Cette action ne peut pas être annulée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus semua pemisah kustom Anda dan mengembalikan default. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo cancellerà tutti i tuoi delimitatori personalizzati e ripristinerà i predefiniti. Questa azione non può essere annullata."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 사용자 지정 구분 기호를 지우고 기본값으로 복원합니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil slette alle egendefinerte delimitere og gjenopprette standardene. Denne handlingen kan ikke angres."
