{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RedSn0w1877/PixlAudio-iOS/blob/main/cloud/runpod-worker/schema/v1/selftest.result.schema.json",
  "title": "PixlAudio Cloud Studio selftest result (pixl.cloudstudio.selftest v1)",
  "description": "Job output of op selftest (no audio, no storage). The app sends the highest v listed in supported. The deploy script passes when worker.gitSha matches the image it deployed.",
  "type": "object",
  "required": ["schema", "v", "status", "supported", "worker", "models", "versions"],
  "properties": {
    "schema": {"const": "pixl.cloudstudio.selftest"},
    "v": {"const": 1},
    "status": {"enum": ["ok", "error"]},
    "supported": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "ops": {"type": "array", "items": {"type": "string"}},
    "worker": {
      "type": "object",
      "required": ["version", "gitSha", "gpu", "vramGB", "cuda"],
      "properties": {
        "version": {"type": "string"},
        "gitSha": {"type": "string"},
        "gpu": {"type": ["string", "null"]},
        "vramGB": {"type": ["number", "null"]},
        "cuda": {"type": ["string", "null"]}
      }
    },
    "models": {
      "type": "object",
      "description": "Model id -> loaded (true), available but lazy (\"lazy\"), or missing (false).",
      "additionalProperties": {"enum": [true, false, "lazy"]}
    },
    "versions": {
      "type": "object",
      "description": "python, torch, runpod, ffmpeg and the model libraries.",
      "additionalProperties": {"type": ["string", "null"]}
    },
    "wordTimingLanguages": {"type": "array", "items": {"type": "string"}, "description": "Languages that get word timing; everything else gets line timing."},
    "coldStartMs": {"type": "integer", "minimum": 0},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}
      ]
    }
  }
}
