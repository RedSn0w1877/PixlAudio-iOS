      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The library reaches %1$lld Hz, above the current output sample rate."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bibliothek erreicht %1$lld Hz, was über der aktuellen Ausgangs-Sample-Rate liegt."
