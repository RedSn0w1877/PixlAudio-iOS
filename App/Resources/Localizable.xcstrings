          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 백업에서 찾아보거나 선택하세요. 선택한 데이터가 현재 데이터를 대체합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
