        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ya tienes una copia de PixlAudio, restáurala ahora y omite la mayor parte del resto de la configuración en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez déjà une sauvegarde PixlAudio, restaurez-la maintenant pour passer la majeure partie de la configuration restante."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda sudah memiliki cadangan PixlAudio, pulihkan sekarang dan lewati sebagian besar penyiapan yang tersisa di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai già un backup di PixlAudio, ripristinalo ora e salta la maggior parte del setup rimanente su questo dispositivo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 PixlAudio 백업이 있는 경우, 지금 복구하여 나머지 설정 과정을 건너뛸 수 있습니다."
