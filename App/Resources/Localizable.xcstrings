    "word_delimiter_help_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word delimiters are matched case-insensitively with spaces around them.\n\nSingle-character delimiters (like \"x\") require spaces on both sides to avoid false matches.\n\nExamples:\n \"Drake feat. Rihanna\" -> Drake, Rihanna\n \"Marshmello x Bastille\" -> Marshmello, Bastille\n \"A vs. B\" -> A, B"
          }
        }
      }
    },
